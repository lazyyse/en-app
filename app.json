{
  "expo": {
    "name": "OneTap English",
    "slug": "onetap-english",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "description": "タップするだけで英語力アップ！TOEIC 600点を目指す学習アプリ。単語・会話・文法の200問でスキルを伸ばそう。",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rachel6.onetapenglish",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "このアプリは関連性の高い広告を表示するためにトラッキングを使用することがあります。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rachel6.onetapenglish",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5684305999603503~2010191050",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9c6ac23d-5d77-4168-8c39-248c0b0bc786"
      }
    },
    "owner": "rachel6"
  }
}
